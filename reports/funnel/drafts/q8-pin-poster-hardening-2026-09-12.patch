+def fake_response(status, body=None):
+    """Build a minimal requests.Response stand-in."""
+    resp = MagicMock()
+    resp.status_code = status
+    if body is None:
+        resp.text = 'not json'
+        resp.json.side_effect = ValueError('no json')
+    else:
+        resp.text = json.dumps(body)
+        resp.json.return_value = body
+    return resp
+
+
+SECTION_GONE = {'code': 2031, 'message': 'Board section not found.'}
+
+
+class TestIsSectionNotFound(unittest.TestCase):
+
+    def test_404_is_section_not_found(self):
+        self.assertTrue(is_section_not_found(fake_response(404, SECTION_GONE)))
+
+    def test_404_without_json_body_is_section_not_found(self):
+        self.assertTrue(is_section_not_found(fake_response(404)))
+
+    def test_code_2031_with_other_status_is_section_not_found(self):
+        self.assertTrue(is_section_not_found(fake_response(400, SECTION_GONE)))
+
+    def test_other_errors_are_not(self):
+        self.assertFalse(is_section_not_found(
+            fake_response(400, {'code': 1, 'message': 'Invalid image'})))
+        self.assertFalse(is_section_not_found(fake_response(500)))
+        self.assertFalse(is_section_not_found(fake_response(429, {'code': 8})))
+
+
+class TestSectionGoneRetry(unittest.TestCase):
+    """A deleted board section must not block the queue: retry once on the
+    board root, and only for the section-not-found error."""
+
+    CONFIG = {'creator_access_token': 'tok'}
+
+    def _upload(self, responses, section_id='sec-1'):
+        with patch('supabase_pin_poster_server.requests.post',
+                   side_effect=responses) as mock_post:
+            result = upload_pin_from_url(
+                self.CONFIG, 'https://img/x.png', 'Title', 'https://link',
+                'board-1', section_id=section_id, description='desc')
+        return result, mock_post
+
+    def _payloads(self, mock_post):
+        return [c[1]['json'] for c in mock_post.call_args_list]
+
+    def test_section_gone_retries_once_on_board_root(self):
+        result, mock_post = self._upload([
+            fake_response(404, SECTION_GONE),
+            fake_response(201, {'id': 'pin-1'}),
+        ])
+        self.assertEqual(result, {'id': 'pin-1'})
+        self.assertEqual(mock_post.call_count, 2)
+        first, second = self._payloads(mock_post)
+        self.assertEqual(first['board_section_id'], 'sec-1')
+        self.assertNotIn('board_section_id', second)
+        self.assertEqual(second['board_id'], 'board-1')
+        # Everything else about the pin is unchanged on the retry.
+        for key in ('title', 'description', 'link', 'alt_text', 'media_source'):
+            self.assertEqual(first[key], second[key])
+
+    def test_retry_happens_only_once(self):
+        gone = fake_response(404, SECTION_GONE)
+        result, mock_post = self._upload([gone, gone, gone])
+        self.assertIsNone(result)
+        self.assertEqual(mock_post.call_count, 2)
+
+    def test_code_2031_without_404_status_also_retries(self):
+        result, mock_post = self._upload([
+            fake_response(400, SECTION_GONE),
+            fake_response(201, {'id': 'pin-2'}),
+        ])
+        self.assertEqual(result, {'id': 'pin-2'})
+        self.assertEqual(mock_post.call_count, 2)
+
+    def test_no_retry_when_no_section_was_sent(self):
+        result, mock_post = self._upload([fake_response(404, SECTION_GONE)],
+                                         section_id=None)
+        self.assertIsNone(result)
+        self.assertEqual(mock_post.call_count, 1)
+        self.assertNotIn('board_section_id', self._payloads(mock_post)[0])
+
+    def test_no_retry_on_other_errors(self):
+        result, mock_post = self._upload([
+            fake_response(400, {'code': 1, 'message': 'Invalid image'}),
+            fake_response(201, {'id': 'never'}),
+        ])
+        self.assertIsNone(result)
+        self.assertEqual(mock_post.call_count, 1)
+
+    def test_success_with_section_does_not_retry(self):
+        result, mock_post = self._upload([fake_response(201, {'id': 'pin-3'})])
+        self.assertEqual(result, {'id': 'pin-3'})
+        self.assertEqual(mock_post.call_count, 1)
+        self.assertEqual(self._payloads(mock_post)[0]['board_section_id'], 'sec-1')
+
+
 if __name__ == '__main__':
     unittest.main()
