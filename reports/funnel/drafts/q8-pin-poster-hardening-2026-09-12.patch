 PINTEREST_API_BASE = 'https://api.pinterest.com/v5'
 
+# Pinterest API error code returned when board_section_id no longer exists.
+SECTION_NOT_FOUND_CODE = 2031
 
+
+def is_section_not_found(resp):
+    """True if Pinterest rejected the pin because the board section is gone
+    (HTTP 404 and/or API error code 2031)."""
+    if resp.status_code == 404:
+        return True
+    try:
+        return resp.json().get('code') == SECTION_NOT_FOUND_CODE
+    except Exception:
+        return False
