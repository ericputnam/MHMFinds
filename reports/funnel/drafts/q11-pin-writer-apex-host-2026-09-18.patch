+# Canonical public origin for every pin destination.
+#
+# The WordPress REST `link` field returns the blog's own home URL. Depending on
+# which host this box's config.json points at, that is either the apex or
+# https://blog.musthavemods.com/... -- the proxied duplicate of the canonical
+# page. A pin written with the blog host still resolves, but its sessions
+# attribute to a URL nothing else in the funnel optimises, and the poster has
+# to fall back to a second Supabase lookup to find the row again
+# (daily_pin_poster_server.update_supabase_entries). Normalise once, here, so
+# the row is right regardless of how the host is configured.
+CANONICAL_HOST = 'musthavemods.com'
+CANONICAL_HOST_ALIASES = (
+    'musthavemods.com',
+    'www.musthavemods.com',
+    'blog.musthavemods.com',
+    'www.blog.musthavemods.com',
+)
+
+
+def canonicalize_post_url(url):
+    """Rewrite a MustHaveMods post URL onto https://musthavemods.com.
+
+    blog.* / www.* / http:// are normalised; path, query and fragment are kept
+    byte for byte. Any other host, and anything unparseable, is returned
+    unchanged -- this must never touch a third-party link.
+    """
+    if not url:
+        return url
+    try:
+        parts = urlparse(url)
+    except Exception:
+        return url
+    # netloc may carry credentials and/or a port; compare on the bare host.
+    host = (parts.netloc or '').split('@')[-1].split(':')[0].lower()
+    if host not in CANONICAL_HOST_ALIASES:
+        return url
+    return urlunparse(('https', CANONICAL_HOST, parts.path, parts.params,
+                       parts.query, parts.fragment))
 
