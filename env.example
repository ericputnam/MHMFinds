# ============================================
# Copy this file to .env.local and fill in your values:  cp env.example .env.local
# This is the ONLY env template in the repo. Add new variables here, with a comment
# saying which file reads them. Placeholders only — never a real value.
# ============================================

# Database (the two are often swapped — see CLAUDE.md "Prisma Accelerate")
# DATABASE_URL = Prisma Accelerate URL (enables query caching)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your-accelerate-api-key"
# DIRECT_DATABASE_URL = direct Postgres connection, used by migrations (prisma/schema.prisma)
DIRECT_DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin login (lib/authOptions.ts, scripts/create-admin.ts). No default password exists.
ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD="your-strong-admin-password"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# OpenAI API (for AI features)
OPENAI_API_KEY="your-openai-api-key"

# Perplexity API (optional — lib/services/perplexityService.ts)
PERPLEXITY_API_KEY="your-perplexity-api-key"

# Scraper AI (optional — local Ollama instead of OpenAI for the scrapers)
USE_AI_SCRAPER=false
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Verbose scraper logging (lib/services/mhmScraper.ts)
# SCRAPER_VERBOSE="1"

# Content Source APIs
PATREON_CLIENT_ID="your-patreon-client-id"
PATREON_CLIENT_SECRET="your-patreon-client-secret"
# Membership via Patreon OAuth (lib/membership.ts). No-op until the flag is "1".
# Flag is NEXT_PUBLIC_ (inlined at build) — flipping it in Vercel needs a redeploy.
NEXT_PUBLIC_MEMBERSHIP_ENABLED="0"
# Affiliate placement kill switch (lib/affiliatePlacements.ts, E55 2026-09-15).
# UNSET = code defaults (grid on; mod_page, interstitial, sidebar off).
# When set it is an exact allow-list: "grid,mod_page,interstitial" restores the
# pre-E55 layout, "none" hides every placement. NEXT_PUBLIC_ → redeploy to apply.
# Leave it commented out unless you are overriding the defaults — an empty
# string is read as "none", not as "use defaults".
# NEXT_PUBLIC_AFFILIATE_PLACEMENTS="grid"
PATREON_CAMPAIGN_ID="your-patreon-campaign-id"
PATREON_MEMBER_MIN_CENTS="0"
CURSEFORGE_API_KEY="your-curseforge-api-key"

# Privacy Settings for Content Aggregation
PRIVACY_LEVEL="default" # Options: default, stealth, conservative

# Cache (optional — lib/cache.ts). Upstash REST only: the URL must be https:// and both
# values must be set, or caching is silently skipped. A redis://localhost URL never works.
REDIS_URL="https://your-instance.upstash.io"
REDIS_TOKEN="your-upstash-rest-token"

# File storage: Vercel Blob (lib/imageUpload.ts, lib/services/imageUploader.ts)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"

# Email fallback (lib/services/emailNotifier.ts). SMTP below is preferred; SendGrid is
# only used when SMTP_* is not configured.
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@musthavemods.com"

# Cloudflare Turnstile on /submit-mod (lib/services/turnstile.ts, app/submit-mod/page.tsx)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Stripe (lib/services/stripeService.ts, app/api/webhooks/stripe, app/sign-in/page.tsx)
# Use TEST keys in development: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_CURIOUS_MONTHLY_PRICE_ID="price_your_monthly_price_id"
NEXT_PUBLIC_STRIPE_CURIOUS_QUARTERLY_PRICE_ID="price_your_quarterly_price_id"
NEXT_PUBLIC_STRIPE_CURIOUS_SEMIANNUAL_PRICE_ID="price_your_semiannual_price_id"
NEXT_PUBLIC_STRIPE_CURIOUS_ANNUAL_PRICE_ID="price_your_annual_price_id"

# Analytics / revenue reporting (lib/services/ga4Connector.ts, mediavineConnector.ts, scripts/agents)
GA4_PROPERTY_ID="your-ga4-property-id"
GA4_SERVICE_ACCOUNT_KEY="path-or-json-for-your-ga4-service-account"
MEDIAVINE_EMAIL="your-mediavine-login-email"
MEDIAVINE_PASSWORD="your-mediavine-password"
MEDIAVINE_TOTP_SECRET="your-mediavine-totp-secret"

# Slack webhook for monetization-agent alerts (lib/services/slackNotifier.ts)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# Development
NODE_ENV="development"

# Affiliate Network Reporting APIs (commission/conversion ingestion)
# Impact.com: dashboard -> Settings -> API (publisher account 2956236)
IMPACT_ACCOUNT_SID="your-impact-account-sid"
IMPACT_AUTH_TOKEN="your-impact-auth-token"
# Rakuten Advertising: developer portal -> application Client ID/Secret + publisher Site ID
RAKUTEN_CLIENT_ID="your-rakuten-client-id"
RAKUTEN_CLIENT_SECRET="your-rakuten-client-secret"
RAKUTEN_SID="your-rakuten-publisher-sid"
# CJ Affiliate: developers.cj.com -> Authentication -> Personal Access Tokens
CJ_PERSONAL_ACCESS_TOKEN="your-cj-personal-access-token"
CJ_PUBLISHER_ID="your-cj-publisher-id"
# Note: Amazon Associates has no earnings API - import the earnings CSV via the
# admin dashboard (/admin/monetization/affiliates -> Amazon CSV)

# Cron authentication (Vercel cron jobs send this as a Bearer token)
CRON_SECRET="your-cron-secret"

# Newsletter / notifications over the BigScoots mailbox (operator decision 2026-09-05; preferred over SendGrid)
SMTP_HOST="your-smtp-host"
SMTP_PORT="587"
SMTP_USER="news@musthavemods.com"
SMTP_PASS="your-mailbox-password"
# From address on every outgoing message. Resolved at send time (lib/services/emailNotifier.ts);
# without it mail leaves as noreply@musthavemods.com.
EMAIL_FROM="simsnews@musthavemods.com"
# CAN-SPAM (15 U.S.C. 7704(a)(5)): the sender's valid physical postal address, printed in the
# footer of every list email. lib/services/bulkMailer.ts refuses a real send without it and
# rejects any bracketed placeholder left in the rendered body.
EMAIL_POSTAL_ADDRESS="MustHaveMods, 123 Example St, City, ST 00000"
# Messages per rolling hour. Clamped in code to DEFAULT_HOURLY_LIMIT (100) until BigScoots
# confirms a higher number — setting this above 100 has no effect.
SMTP_HOURLY_LIMIT="100"
# nodemailer pool sizing (defaults 1 and 50 when unset).
SMTP_MAX_CONNECTIONS="1"
SMTP_MAX_MESSAGES="50"
# HMAC key for per-recipient unsubscribe links (lib/services/unsubscribe.ts). Falls back to
# NEXTAUTH_SECRET, which silently breaks links signed in one environment and verified in another.
# Set the SAME value in .env.local AND Vercel Production: openssl rand -hex 32
UNSUBSCRIBE_SECRET="generate-with-openssl-rand-hex-32"
# Mailbox for RFC 2369 mailto: unsubscribes. Must actually exist at the provider or readers bounce.
UNSUBSCRIBE_MAILBOX="simsnews@musthavemods.com"
# Absolute site origin used to build unsubscribe/confirm links inside emails.
NEXT_PUBLIC_SITE_URL="https://musthavemods.com"
# Weekly newsletter cron (app/api/cron/weekly-newsletter). Not scheduled until the
# vercel.json cron line lands (E78 Part B, Tier 2). UNSET/anything but "true" = every run
# no-ops; the route also 401s without the CRON_SECRET bearer (fails closed if unset).
# Reuses the manual send path (bulkMailer + sendExclusions). Turning it on is a Tier 1 send.
NEWSLETTER_WEEKLY_ENABLED="false"

# Funnel-team read access (operator-queue Q2)
PATREON_CREATOR_ACCESS_TOKEN="your-patreon-creator-access-token"
# Optional override for where scripts/_patreon-auth.ts persists a refreshed Patreon token pair.
# Default: the main checkout's .env.local (resolved via the worktree's .git pointer), never the
# cwd's copy — a single-use refresh token written to a throwaway worktree is lost. Set only when
# running from a tree that is not linked to the operator's checkout (#201).
# PATREON_ENV_FILE="/absolute/path/to/operator-checkout/.env.local"
# Pinterest: prefer the refresh-token manager in ~/java_projects/MHMUtils over a 30-day access token
PINTEREST_ACCESS_TOKEN="your-pinterest-v5-access-token"
